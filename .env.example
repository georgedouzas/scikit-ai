# Copy to `.env` and fill in. `.env` is git-ignored and loaded only by the end-to-end tests (`pdm e2e`).
OPENAI_API_KEY=
# Set to 1 to also run the video generation tests, which cost more.
SKAI_E2E_VIDEO=0
# Set to 1 to also run the fine-tuning tests, which take minutes and cost more.
SKAI_E2E_FINETUNE=0
